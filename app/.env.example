# Plantilla de configuración del cliente Streamlit.
# Copiar como app/.env (ignorado por git) solo si se quiere cambiar algo.
# Dentro del Codespace NO hace falta: docker-compose.yml ya define N8N_CHAT_URL.

# URL interna del webhook del agente (contenedor dev -> contenedor n8n).
# Desde dentro del Codespace SIEMPRE http://n8n:5678 (nunca la URL https).
N8N_CHAT_URL=http://n8n:5678/webhook/agente-reservas

# Solo para desarrollar en un PC fuera del Codespace (Integrante 3):
# usar la URL pública del Codespace con el puerto 5678 en "Public".
# N8N_CHAT_URL=https://<nombre-del-codespace>-5678.app.github.dev/webhook/agente-reservas

# Tiempo máximo de espera de una respuesta del agente, en segundos.
N8N_TIMEOUT_S=120
